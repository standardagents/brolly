{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brolly-guard",
  "main": "apps/guard-worker/src/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brolly-guard",
      "database_id": "REPLACE_DURING_INSTALL",
      "migrations_dir": "apps/guard-worker/migrations"
    }
  ],
  "limits": { "cpu_ms": 30000, "subrequests": 200 },
  "observability": { "enabled": true }
}
