{
  "name": "@standardagents/brolly-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.client.config.ts && vite build && node scripts/prerender.mjs",
    "deploy": "pnpm build && pnpm deploy:built",
    "deploy:built": "wrangler deploy",
    "deploy:ci": "wrangler deploy --config wrangler.ci.jsonc",
    "dev": "pnpm build && wrangler dev",
    "dev:hmr": "vite --config vite.dev.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.169.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}
