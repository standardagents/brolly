{
  "name": "@standardagents/brolly-guard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@standardagents/brolly-core": "workspace:*",
    "@standardagents/brolly-notifiers": "workspace:*",
    "@standardagents/brolly-runtime": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm db:migrate:remote && pnpm deploy:built",
    "deploy:built": "node ../../scripts/deploy-guard.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config ../../wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}
