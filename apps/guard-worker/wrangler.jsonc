{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brolly-guard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brolly-guard",
      "database_id": "REPLACE_DURING_INSTALL",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BROLLY_ACCOUNT_ID": "REPLACE_DURING_INSTALL",
    "BROLLY_TIMEZONE": "UTC",
    "BROLLY_DAILY_SUMMARY_HOUR": "9"
  },
  "observability": { "enabled": true }
}
