{
  "name": "@standardagents/brolly",
  "version": "0.1.0",
  "description": "Self-hosted Cloudflare cost sentinel and emergency control plane",
  "type": "module",
  "bin": { "brolly": "dist/index.js" },
  "exports": "./dist/index.js",
  "files": ["dist", "worker", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.chmodSync('dist/index.js',0o755))\"",
    "prepack": "pnpm --filter @standardagents/brolly-guard build && node scripts/package-worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "keywords": ["cloudflare", "billing", "durable-objects", "finops", "monitoring"]
}
